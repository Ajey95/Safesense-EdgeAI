menu "SafeSense environmental node"

config SAFESENSE_WIFI_SSID
    string "Wi-Fi SSID"
    default ""

config SAFESENSE_WIFI_PASSWORD
    string "Wi-Fi password"
    default ""

config SAFESENSE_MQTT_BROKER_URI
    string "MQTT broker URI"
    default "mqtt://192.168.1.2:1883"

config SAFESENSE_DEVICE_ID
    string "Device ID"
    default "safesense-env-01"

config SAFESENSE_SAMPLE_INTERVAL_SECONDS
    int "Telemetry interval in seconds"
    range 2 3600
    default 10

endmenu
