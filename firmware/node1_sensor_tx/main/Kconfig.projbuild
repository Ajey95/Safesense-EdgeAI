menu "SafeSense Node 1"

config SAFESENSE_AP_SSID
    string "Review SoftAP SSID"
    default "SafeSense-V2"

config SAFESENSE_AP_PASSWORD
    string "Review SoftAP password (empty for open lab network)"
    default ""

config SAFESENSE_AP_CHANNEL
    int "SoftAP channel"
    range 1 13
    default 6

config SAFESENSE_I2C_SDA_GPIO
    int "BME680 SDA GPIO"
    default 8

config SAFESENSE_I2C_SCL_GPIO
    int "BME680 SCL GPIO"
    default 9

config SAFESENSE_BME680_ADDRESS
    hex "BME680 I2C address"
    default 0x76

config SAFESENSE_SENSOR_LED_GPIO
    int "Node 1 sensor status LED GPIO"
    default 4

config SAFESENSE_SENSOR_LED_ACTIVE_HIGH
    bool "Sensor status LED is active high"
    default y

config SAFESENSE_SENSOR_INTERVAL_MS
    int "Environmental sample interval (ms)"
    range 500 60000
    default 3000

config SAFESENSE_GAS_WARMUP_SAMPLES
    int "Valid gas samples required before classification"
    range 1 1000
    default 30

config SAFESENSE_GAS_BASELINE_ALPHA_PERMILLE
    int "Gas baseline EMA alpha (per mille)"
    range 1 1000
    default 20

config SAFESENSE_GAS_WARNING_PERCENT
    int "Warning ratio threshold (percent of baseline)"
    range 2 99
    default 75

config SAFESENSE_GAS_CRITICAL_PERCENT
    int "Critical ratio threshold (percent of baseline)"
    range 1 98
    default 50

config SAFESENSE_REGISTRATION_PORT
    int "Node 2 registration UDP port"
    range 1024 65535
    default 3334

config SAFESENSE_PROBE_PORT
    int "Node 2 probe UDP port"
    range 1024 65535
    default 3333

endmenu
